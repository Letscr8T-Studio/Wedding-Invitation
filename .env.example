# Google Apps Script web app URL (see docs/RSVP_SETUP.md). Copy to .env.local.
VITE_RSVP_ENDPOINT=https://script.google.com/macros/s/XXXX/exec

# Public site address, used for absolute link-preview URLs (og:image). On Vercel this
# falls back to the production domain automatically; set it if you use a custom domain.
VITE_SITE_URL=https://example.com
